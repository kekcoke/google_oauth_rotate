# simple/ — copy to .env, fill in, then: chmod 600 .env
# .env is git-ignored. Never commit a filled-in copy. See ../docs/security-model.md

# Full URL of the application's refresh endpoint (required)
REFRESH_URL=

# Shared secret sent with the request so anything on the network cannot trigger refreshes
# (recommended — REQ-100-15)
REFRESH_SECRET=

# Log directory inside the container. Must be a mounted volume (REQ-100-08)
LOG_DIR=/logs

# Consecutive failures before the healthcheck reports unhealthy (REQ-100-09)
FAIL_THRESHOLD=3

# homelab/ — copy to .env, fill in, then: chmod 600 .env
# .env is git-ignored. Never commit a filled-in copy. See ../docs/security-model.md
#
# Note what is absent: the Google client secret and every refresh token live in Vault,
# not here (REQ-302-01, REQ-302-16). This file holds addresses and non-secret identifiers.

DATABASE_URL=postgres://oauth:CHANGEME@postgres:5432/oauth
REDIS_URL=redis://redis:6379

# Web-application OAuth client id. The secret is read from Vault at start-up
GOOGLE_CLIENT_ID=

# Exact-match HTTPS callback, no wildcards (REQ-003-14)
GOOGLE_REDIRECT_URI=https://example.invalid/oauth2callback

# Publishing status of the OAuth client: testing | production | internal.
# Not a secret, but required — the code cannot discover it, and it drives the
# 7-day refresh-token age warnings (REQ-002-13, REQ-007-08). Leave as `testing`
# until an exit is taken; see docs/production-verification.md
OAUTH_PUBLISHING_STATUS=testing

# Vault / OpenBao. VAULT_SECRET_ID_FILE is a path to an injected secret, never the value itself
VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID_FILE=/run/secrets/vault_secret_id

# Pub/Sub push receiver: the audience the OIDC token must carry (REQ-006-04)
PUBSUB_TOPIC=projects/CHANGEME/topics/gmail-events
PUBSUB_AUDIENCE=

# Exactly ONE replica may set this true, or repeatable jobs are registered twice (REQ-300-08)
IS_SCHEDULER=true

TICK_MS=300000
SKEW_MS=600000
HEALTH_PORT=8080

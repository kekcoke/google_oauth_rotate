# mac/ — copy to .env, fill in, then: chmod 600 .env
# .env is git-ignored. Never commit a filled-in copy. See ../docs/security-model.md
#
# TOKEN_ENC_KEY is deliberately NOT set here: the container cannot read the macOS Keychain,
# so the operator's start wrapper injects it at `docker compose up`. See docs/deploy.md.

# Desktop-app OAuth client (required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Loopback redirect. Must match the registered URI exactly, including port and path
GOOGLE_REDIRECT_URI=http://localhost:8765/oauth2callback

# Identifies the encryption key in stored ciphertext, so it can be rotated (REQ-001-05)
TOKEN_ENC_KEY_ID=

# sqlite:///data/tokens.db (default) or a Postgres URL
DATABASE_URL=sqlite:///data/tokens.db

# Evaluation interval, ms (default 300000 = 5 min — REQ-200-01)
TICK_MS=300000

# Refresh window before expiry, ms (default 600000 = 10 min — REQ-002-01)
SKEW_MS=600000

# Health endpoint port, bound to localhost only (REQ-200-10)
HEALTH_PORT=8080
